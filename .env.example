# Bereket Dairy — copy to .env for local development. Never commit real values.
# Local development uses a LOCAL PostgreSQL database. Never point this at the plastic system's database.
DATABASE_URL="postgresql://dairy:dairy_dev@localhost:5432/dairy"
DATABASE_URL_UNPOOLED="postgresql://dairy:dairy_dev@localhost:5432/dairy"

# Drives "today" and every displayed time.
FACTORY_TIMEZONE="Asia/Baghdad"

# One-time code for /setup (first administrator). Remove or replace after setup.
SETUP_TOKEN=""

# Optional. Without it, uploaded files go to ./.uploads (development only).
BLOB_READ_WRITE_TOKEN=""

# Optional Web Push (npx web-push generate-vapid-keys). The private key is server-only.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Optional: oldest date FIFO costing looks at (default 2000-01-01).
# FIFO_START="2000-01-01"
